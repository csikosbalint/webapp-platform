# Resolve @csikosbalint/* from GitHub Packages instead of npmjs.
#
# NPM_TOKEN must be present at install time. On Vercel, set it as a project
# environment variable (a classic PAT with read:packages); GitHub Packages
# requires auth even for public packages, so installs fail without it.
#
# Safe to commit: the token is expanded from the environment, not stored here.

@csikosbalint:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NPM_TOKEN}
