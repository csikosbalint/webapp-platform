# Publish target for this package. Safe to commit: NPM_TOKEN is expanded from
# the environment at run time, so no credential is stored here.
#
# Local publish:  NPM_TOKEN=<PAT with write:packages> pnpm publish
# CI:             NPM_TOKEN comes from secrets.GITHUB_TOKEN (packages: write)

@csikosbalint:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NPM_TOKEN}
